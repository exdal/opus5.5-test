<rml>
<head>
	<title>OxCity HUD</title>
	<link type="text/rcss" href="style.rcss"/>
</head>
<body data-model="hud">
	<!-- Hotline style kill feedback: a red wash over everything, then the combo and the points -->
	<div id="kill-flash" data-style-opacity="kill_flash"></div>
	<div id="combo" data-if="combo != '' &amp;&amp; !menu_visible"
		data-style-transform="'rotate(' + combo_tilt + 'deg) scale(' + combo_scale + ')'">{{ combo }}</div>
	<div id="score-popup" data-if="score_popup != '' &amp;&amp; !menu_visible">{{ score_popup }}</div>
	<div id="score" data-if="score > 0 &amp;&amp; !menu_visible">{{ score }} PTS</div>

	<div id="money" data-if="!menu_visible">${{ money }}</div>

	<div id="stars" data-if="!menu_visible">
		<div class="star" data-class-lit="wanted >= 1"></div>
		<div class="star" data-class-lit="wanted >= 2"></div>
		<div class="star" data-class-lit="wanted >= 3"></div>
		<div class="star" data-class-lit="wanted >= 4"></div>
		<div class="star" data-class-lit="wanted >= 5"></div>
	</div>

	<div id="pager" data-if="pager != '' &amp;&amp; !menu_visible">{{ pager }}</div>

	<div id="health" data-if="!menu_visible">
		<div id="health-bar"><div id="health-fill" data-style-width="health + '%'"></div></div>
		<div id="weapon">{{ weapon }}<span data-if="weapon == 'PISTOL'">  x{{ ammo }}</span></div>
	</div>

	<div id="prompt" data-if="prompt != '' &amp;&amp; !menu_visible">{{ prompt }}</div>

	<div id="vehicle" data-if="vehicle != '' &amp;&amp; !menu_visible">{{ vehicle }}<br/><span>{{ speed }} KM/H</span></div>

	<div id="heist" data-if="heist_active">
		DRILLING THE VAULT... {{ heist_progress }}%
		<div id="heist-bar"><div id="heist-fill" data-style-width="heist_progress + '%'"></div></div>
	</div>

	<!-- multiplayer: who's who above their heads, the scores, and who wasted whom -->
	<div id="tags" data-if="!menu_visible">
		<div class="name-tag" data-for="tag : tags"
			data-style-left="tag.x + 'px'" data-style-top="tag.y + 'px'" data-class-wanted="tag.stars > 0">{{ tag.name }}</div>
	</div>

	<div id="scoreboard" data-if="online &amp;&amp; !menu_visible">
		<div class="score-row" data-for="row : scoreboard" data-class-me="row.me">
			<span class="score-name">{{ row.name }}</span>
			<span class="score-stars" data-if="row.stars > 0">{{ row.stars }}*</span>
			<span class="score-points">{{ row.score }}</span>
			<span class="score-kills">{{ row.kills }} K</span>
		</div>
	</div>

	<div id="kill-feed" data-if="!menu_visible">
		<div class="feed-line" data-for="line : kill_feed">{{ line }}</div>
	</div>

	<div id="big-text" data-if="big_text != ''">{{ big_text }}</div>
	<div id="big-sub" data-if="big_text != ''">{{ stats }}</div>
</body>
</rml>
